<%# locals: (client:) %>
<%# The QuickBooks tab on each client (the :client_panel slot): which customer it is, and its
    invoices; or linking it to one. %>
<% customer = client.quickbooks_customer %>
<% invoices = client.quickbooks_invoices.live.includes(:work).recent.limit(10).to_a %>
<% if customer || can?(:manage_billing) %>
  <% unlink = nil %>
  <% if customer && can?(:manage_billing) %>
    <% unlink = render("layouts/shared/delete_dialog", name: "the link to " + customer.display_name.to_s, path: quickbooks_client_customer_path(client),
         message: "Runwell stops invoicing and mirroring for this client. Nothing changes in QuickBooks.") %>
  <% end %>
  <%= record_card "QuickBooks", id: "quickbooks", css: "qb-card",
        hint: customer ? safe_join([ "Customer ", tag.strong(customer.display_name), (" · " + customer.email if customer.email.present?) ].compact) : "Which QuickBooks customer #{client.name} is, so it can be invoiced.",
        action: unlink do %>
    <% if customer %>
      <% if invoices.any? %>
        <ul class="qb-list">
          <% invoices.each do |invoice| %>
            <%# herb:key invoice.id %>
            <li data-filter-target="item">
              <%= render "quickbooks/invoice", invoice: invoice %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <%= ui :empty, size: :sm, description: "No invoices yet." %>
      <% end %>
    <% elsif Quickbooks::Connection.ready? %>
      <div class="qb-actions qb-actions--start">
        <details class="record-add qb-add">
          <summary class="ui-button" data-variant="outline" data-size="sm"><%= icon_tag "add" %> <span>Link to a QuickBooks customer</span></summary>
          <%= form_with url: quickbooks_client_customer_path(client), scope: :customer, namespace: "qbo_link", class: "qb-form" do |form| %>
            <%= form.ui :field, :qbo_id, label: "QuickBooks customer id" do %>
              <%= form.text_field :qbo_id, required: true, autocomplete: "off" %>
            <% end %>
            <div class="qb-actions"><%= ui :button, type: :submit, size: :sm, content: "Link customer" %></div>
          <% end %>
        </details>
        <details class="record-add qb-add">
          <summary class="ui-button" data-variant="ghost" data-size="sm">Create the customer in QuickBooks</summary>
          <%= form_with url: quickbooks_client_customer_path(client), scope: :customer, namespace: "qbo_new", class: "qb-form" do |form| %>
            <%= form.ui :field, :email, label: "Billing email" do %>
              <%= form.email_field :email, value: client.approvers.first&.email, autocomplete: "off" %>
            <% end %>
            <div class="qb-actions"><%= ui :button, type: :submit, size: :sm, content: "Create #{client.name} in QuickBooks" %></div>
          <% end %>
        </details>
      </div>
      <p class="qb-muted">The nightly sync links a customer with exactly this client’s name by itself.</p>
    <% else %>
      <% if can?(:manage_settings) %>
        <%= ui :empty, size: :sm, description: "Connect QuickBooks to invoice this client.", action: ui(:button, href: quickbooks_settings_path, variant: :outline, size: :sm, content: "QuickBooks settings") %>
      <% else %>
        <%= ui :empty, size: :sm, description: "Connect QuickBooks in Settings to invoice this client." %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
