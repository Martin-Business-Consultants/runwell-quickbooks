<%# locals: (invoice:, pay: nil) %>
<%# One invoice: what it is, what's left to pay, and QuickBooks' pay page (for the client). %>
<div class="qb-invoice">
  <div class="qb-invoice__body">
    <span class="qb-invoice__title"><strong><%= invoice.label %></strong> <span class="qb-muted"><%= money invoice.total_cents %></span></span>
    <span class="qb-invoice__meta">
      <%= [ invoice.txn_date && l(invoice.txn_date, format: :short), invoice.due_on && "due " + l(invoice.due_on, format: :short), invoice.work&.title, invoice.sent_to && "sent to " + invoice.sent_to ].compact.join(" · ") %><%= " · " + money(invoice.balance_cents) + " left" if invoice.balance_cents.positive? && invoice.balance_cents < invoice.total_cents %>
    </span>
  </div>
  <span class="qb-invoice__end">
    <%= status_tag invoice.status.humanize %>
    <% if invoice.payment_link.present? && invoice.balance_cents.positive? %>
      <%= ui :button, href: invoice.payment_link, variant: (pay ? :default : :outline), size: :xs, content: (pay ? "Pay" : "Pay link"), target: "_blank", rel: "noopener" %>
    <% end %>
  </span>
</div>
