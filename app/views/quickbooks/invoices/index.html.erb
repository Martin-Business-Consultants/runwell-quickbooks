<% @page_title = "Invoices" %>
<%= render "settings/header", current: :quickbooks %>
<%# Every invoice mirrored from QuickBooks (Quickbooks::InvoicesController#index): open ones unless the filter says otherwise. %>
<div class="settings-page">
  <section class="settings-section">
    <header class="settings-section__head">
      <h2>Invoices</h2>
      <p class="settings-section__description">Mirrored from QuickBooks every night, or with Sync now.</p>
      <div class="settings-section__actions">
        <%= ui :filter, param: :status, label: "Status", value: @status, any: false, options: [ [ "Open", "open" ], [ "Overdue", "overdue" ], [ "All", "all" ] ] %>
      </div>
    </header>
    <% if @invoices.any? %>
      <ul class="qb-list">
        <% @invoices.each do |invoice| %>
          <%# herb:key invoice.id %>
          <li data-filter-target="item">
            <%= render "quickbooks/invoice", invoice: invoice %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <%= ui :empty, size: :sm, description: "No invoices here." %>
    <% end %>
  </section>
</div>
