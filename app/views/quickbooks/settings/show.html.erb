<% @page_title = "QuickBooks" %>
<%= render "settings/header", current: :quickbooks %>
<%# Settings › Plugins › QuickBooks (Quickbooks::SettingsController): the connection and its last
    sync, then the install's own Intuit app and the product or service behind invoice lines. %>
<div class="settings-page">
  <section class="settings-section">
    <header class="settings-section__head">
      <h2>Connection</h2>
      <p class="settings-section__description">
        <%= pluralize(@customers, "client") %> linked to customers, <%= pluralize(@recurring, "service") %> with a recurring invoice.
        <%= link_to "See the invoices", quickbooks_invoices_path %>.
      </p>
    </header>

    <div class="qb-status">
      <% if @connection.connected? %>
        <%= status_tag "Active" %>
        <span>Connected to <strong><%= @connection.company_name || "QuickBooks" %></strong><%= " (sandbox)" if @connection.sandbox? %><%= " since " + l(@connection.connected_at.to_date, format: :long) if @connection.connected_at %>.</span>
      <% else %>
        <%= status_tag "Dormant" %>
        <span>Not connected: <%= @connection.blocker %>.</span>
      <% end %>
    </div>
    <% if @connection.connected? && @connection.blocker %>
      <%= ui :alert, variant: :warning, description: "Can’t invoice yet: #{@connection.blocker}." %>
    <% end %>
    <% if @connection.last_error.present? %>
      <%= ui :alert, variant: :destructive, description: @connection.last_error, class: "qb-alert" %>
    <% end %>

    <% summary = @connection.last_sync_summary %>
    <% if summary.present? %>
      <p class="qb-muted">
        Last sync <%= time_ago_in_words(@connection.last_synced_at) %> ago: <%= pluralize(summary["invoices"].to_i, "invoice") %>, <%= pluralize(summary["payments"].to_i, "payment") %>, <%= pluralize(summary["recurring"].to_i, "recurring invoice") %> checked<%= ", #{summary["customers"]} clients linked by name" if summary["customers"].to_i.positive? %>.
      </p>
      <% errors = Array(summary["errors"]) %>
      <% if errors.any? %>
        <%= ui :alert, variant: :destructive, title: "Some of it couldn’t be read" do %>
          <ul class="qb-errors">
            <% errors.each do |error| %>
              <%# herb:key error %>
              <li><%= error %></li>
            <% end %>
          </ul>
        <% end %>
      <% end %>
    <% end %>

    <% if @connection.configured? || @connection.connected? %>
      <div class="qb-actions qb-actions--start">
        <% if @connection.configured? %>
          <%= button_to quickbooks_authorization_path, class: "ui-button", data: { variant: (@connection.connected? ? "outline" : "default"), size: "default" }, form_class: "qb-inline", form: { data: { turbo: false } } do %>
            <%= icon_tag "globe" %> <span><%= @connection.connected? ? "Reconnect QuickBooks" : "Connect to QuickBooks" %></span>
          <% end %>
        <% end %>
        <% if @connection.connected? %>
          <%= button_to quickbooks_sync_path, class: "ui-button", data: { variant: "outline", size: "default" }, form_class: "qb-inline" do %>
            <%= icon_tag "refresh" %> <span>Sync now</span>
          <% end %>
          <%= render "layouts/shared/confirm", trigger: "Disconnect", title: "Disconnect QuickBooks?",
                body: "Runwell stops invoicing and syncing, and gives up its access at Intuit. Invoices already mirrored stay; nothing changes in QuickBooks.",
                button: "Disconnect", path: quickbooks_settings_path, icon: "remove" %>
        <% end %>
      </div>
    <% end %>
  </section>

  <section class="settings-section">
    <header class="settings-section__head">
      <h2>Credentials and invoice lines</h2>
      <p class="settings-section__description">
        Your own Intuit app (developer.intuit.com › your app › Keys and credentials). Add this redirect URI to it:
      </p>
    </header>
    <%= code_block quickbooks_authorization_url, language: "plain" %>
    <%= form_with model: @connection, url: quickbooks_settings_path, method: :patch, scope: :connection, class: "settings-form" do |form| %>
      <div class="qb-fields">
        <%= form.ui :field, :client_id, label: "Client id" do %>
          <%= form.text_field :client_id, autocomplete: "off" %>
        <% end %>
        <%= form.ui :field, :client_secret, label: "Client secret" do %>
          <%= secret_field form, :client_secret %>
        <% end %>
        <%= form.ui :field, :environment, label: "Environment" do %>
          <%= form.select :environment, Quickbooks::Connection::ENVIRONMENTS.map { [ it.humanize, it ] } %>
        <% end %>
      </div>
      <% if @items.any? %>
        <%= form.ui :field, :default_item_id, label: "Product or service for invoice lines", description: "QuickBooks needs one on every line. Each line keeps Runwell’s own wording." do %>
          <%= form.select :default_item_id, @items.map { [ it["Name"], it["Id"] ] }, { include_blank: "Choose one", selected: @connection.default_item_id } %>
        <% end %>
      <% elsif @connection.default_item_name %>
        <p>Invoice lines use <strong><%= @connection.default_item_name %></strong>.</p>
      <% end %>
      <div><%= ui :button, type: :submit, content: "Save" %></div>
    <% end %>
  </section>
</div>
